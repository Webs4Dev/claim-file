# Copy to .env and fill in. Never commit .env.

# OpenAI credentials and model used by all agents
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Per-claim budget limits (see state/budget.py)
MAX_STEPS=10
MAX_TOKENS=10000
MAX_COST=0.10

# Set to true when served over HTTPS so the session cookie is HTTPS-only
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API (CORS + CSRF check)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
