# Copy to .env and fill in. Never commit .env.

# OpenAI credentials and model used by all agents
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Per-claim budget limits (see state/budget.py)
MAX_STEPS=10
MAX_TOKENS=10000
MAX_COST=0.10

# Session cookie is HTTPS-only unless this is false. Chrome and Firefox
# accept it on http://localhost; set false only if your local browser
# (e.g. Safari) drops the cookie over plain http. Never false in production.
COOKIE_SECURE=true

# Comma-separated browser origins allowed to call the API (CORS + CSRF check)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse proxies whose X-Forwarded-For header uvicorn may trust (comma-
# separated IPs). Empty = trust none, use the direct peer address. Read by
# uvicorn itself, so start it with --env-file .env.
FORWARDED_ALLOW_IPS=
